# Copy this file to .env and fill in real values before starting

# PostgreSQL connection (use container hostname "db" in Docker Compose)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/aiworld

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# DashScope API key
QWEN_API_KEY=sk-YOUR_KEY_HERE

# "development" disables CORS restrictions; "production" enforces ALLOWED_ORIGINS
APP_ENV=production

# Comma-separated allowed origins (only used when APP_ENV=production)
ALLOWED_ORIGINS=https://yourdomain.com
